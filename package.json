{
  "name": "opl3-duo-midi-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Firmware for the OPL3 Duo MIDI project (C++/PlatformIO), plus repo-wide formatting hooks. The companion opl CLI moved to nicolasgalvez/render-tools.",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "format": "git ls-files '*.c' '*.cc' '*.cpp' '*.cxx' '*.h' '*.hpp' '*.ino' | xargs clang-format -i"
  },
  "lint-staged": {
    "*.{c,cc,cpp,cxx,h,hpp,ino}": "clang-format -i",
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.3"
  }
}
